# Copy this file to .env and edit if needed
# Local prototype default
DATABASE_URL=sqlite:///./blockaccred.db
# Deployment-ready PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/blockaccred
SECRET_KEY=change-me-to-a-long-random-string
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_NETWORK=Local Hardhat
# Example for hosted deployment:
# BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
# BLOCKCHAIN_NETWORK=Sepolia
# CONTRACT_ADDRESS=0xYourDeployedContractAddress
# BLOCKCHAIN_PRIVATE_KEY=0xYourDedicatedTestnetWalletPrivateKey
DEPLOYMENT_FILE=../blockchain/deployment.json
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
